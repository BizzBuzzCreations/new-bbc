# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Existing site settings (already used by the website) ---
MONGO_URI=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CRON_SECRET=
RESEND_API_KEY=
SITE_MAIL_RECIEVER=

# --- BizzBee AI chatbot (server-side only; never prefix with NEXT_PUBLIC_) ---
# Required for AI answers. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional. Default is claude-opus-5-5. claude-haiku-5-5 is far cheaper and
# fast enough for a website assistant.
BIZZBEE_MODEL=
